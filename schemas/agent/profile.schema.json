{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Perfil de Agente Aurora",
  "type": "object",
  "properties": {
    "alias": {"type": "string", "minLength": 3},
    "publicKey": {"type": "string"},
    "valuesPolicyHash": {"type": "string"},
    "valuesPolicyVersion": {"type": "string"},
    "bio": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reputation": {
      "type": "object",
      "properties": {
        "coherence": {"type": "number", "minimum": 0},
        "uptime": {"type": "number", "minimum": 0}
      }
    }
  },
  "required": ["alias", "publicKey", "valuesPolicyHash", "valuesPolicyVersion"]
}
