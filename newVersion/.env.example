# Configuración para Aurora Genesis - LLM Semantic Encoder

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4  # o gpt-3.5-turbo para menor costo

# Encoder Configuration
USE_CACHE=true
CACHE_TYPE=memory  # memory, redis, disk
DEMO_MODE=false  # false para usar LLM real, true para heurísticas

# Performance
MAX_BATCH_SIZE=10
RATE_LIMIT_PER_MINUTE=60
TIMEOUT_SECONDS=30

# Quality Thresholds
MIN_COSINE_SIMILARITY=0.85
MIN_TENSOR_VALIDITY=0.95

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_API_CALLS=true
LOG_COSTS=true

# Fallback
FALLBACK_TO_DEMO_ON_ERROR=true
MAX_RETRIES=3
